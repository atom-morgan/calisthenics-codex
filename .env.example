# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> your project -> "Connect" button (top of the page).

# App runtime (Vercel + local dev): the "Transaction pooler" string, port 6543.
# Short-lived serverless functions share a pool instead of each opening a
# direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations only (drizzle-kit): the "Session pooler" string, port 5432.
# Migrations need a regular session; the transaction pooler can break them.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth. Server-only (no NEXT_PUBLIC_ prefix): login/signup/logout
# all run in Server Actions, so the browser never needs these.
# Project Settings -> Data API (URL) and Project Settings -> API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Anthropic API, used to parse typed workouts. Server-only.
# console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-<key>
